<?xml version="1.0" encoding="utf-8"?>
<!--
  First run. The only screen someone sees before any of their own data exists,
  so it carries the app's mark and nothing else — no illustration, no spinner
  standing in for work that is not happening.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?attr/somaBg"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/ivSplash"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/bg_lav_mark_tile">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_splash_mark"
            android:contentDescription="@null" />

    </FrameLayout>

    <TextView
        android:id="@+id/intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/intro_title"
        android:fontFamily="@font/poppins_extrabold"
        android:textColor="?attr/somaTextP"
        android:textSize="@dimen/text_display"
        android:lineSpacingMultiplier="1.06"
        android:letterSpacing="-0.02" />

    <TextView
        android:id="@+id/introdesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/intro_body"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="?attr/somaTextM"
        android:textSize="@dimen/text_body"
        android:lineSpacingMultiplier="1.35" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/pixelbutton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="@drawable/bg_lav_cta"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/intro_cta"
        android:fontFamily="@font/poppins_extrabold"
        android:textColor="?attr/somaOnFill"
        android:textSize="@dimen/text_body" />

    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="36dp" />

</LinearLayout>
