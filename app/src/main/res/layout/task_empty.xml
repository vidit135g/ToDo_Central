<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty state as a row in the list, so the greeting, headline and filter chips
  above it stay on screen and usable. It used to be an overlay centred in the
  window, which drew straight over them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter"
    android:paddingTop="48dp"
    android:paddingBottom="40dp">

    <FrameLayout
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:background="@drawable/bg_lav_circle_light">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_splash_mark"
            app:tint="?attr/somaPrimary"
            android:contentDescription="@null" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:fontFamily="@font/poppins_extrabold"
        android:textColor="?attr/somaTextP"
        android:textSize="@dimen/text_section" />

    <TextView
        android:id="@+id/tvEmptyBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="?attr/somaTextM"
        android:textSize="@dimen/text_caption"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
