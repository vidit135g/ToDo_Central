<?xml version="1.0" encoding="utf-8"?>
<!-- One dependency's notice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    android:background="@drawable/bg_lav_group_card">

    <TextView
        android:id="@+id/tvLicenceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:textColor="?attr/somaTextP"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvLicenceKind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="?attr/somaPrimary"
        android:textSize="@dimen/text_eyebrow"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvLicenceHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/poppins"
        android:textColor="?attr/somaTextM"
        android:textSize="@dimen/text_caption"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
