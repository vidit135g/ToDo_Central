<?xml version="1.0" encoding="utf-8"?>
<!-- Rate prompt: a primary action with two quiet ways out, rather than three
     identical rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="22dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_lav_circle_light">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_soma_star_on"
            app:tint="@color/soma_star"
            android:contentDescription="@null" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/rate_dialog_title"
        android:fontFamily="@font/poppins_extrabold"
        android:textColor="?attr/somaTextP"
        android:textSize="@dimen/text_section" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/rate_dialog_message"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="?attr/somaTextM"
        android:textSize="@dimen/text_caption"
        android:lineSpacingMultiplier="1.35" />

    <TextView
        android:id="@+id/tvRate"
        style="@style/LavDialogButton.Loud"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:text="@string/rate_dialog_ok" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tvShowLater"
            style="@style/LavDialogButton.Quiet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/rate_dialog_cancel" />

        <TextView
            android:id="@+id/tvNeverShow"
            style="@style/LavDialogButton.Quiet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/rate_dialog_no" />

    </LinearLayout>
</LinearLayout>
