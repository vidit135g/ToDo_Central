<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings index. The flat 48dp rows are now grouped cards under eyebrows, so
  the list reads as three concerns rather than one undifferentiated run: what
  the app does, how it behaves, and everything about the app itself.
  Every id is preserved — SettingsActivity binds these by name.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/somaBg"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter">

        <TextView
            style="@style/LavEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_group_app" />

        <LinearLayout
            style="@style/LavGroupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvUI"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_ui"
                android:text="@string/settings_user_interface" />

            <View style="@style/LavRowDivider" />

            <TextView
                android:id="@+id/tvNotifications"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_notifications"
                android:text="@string/settings_notifications" />

            <View style="@style/LavRowDivider" />

            <TextView
                android:id="@+id/tvDateAndTime"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_time"
                android:text="@string/settings_date_and_time" />

        </LinearLayout>

        <TextView
            style="@style/LavEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_group_data" />

        <LinearLayout
            style="@style/LavGroupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvBackupAndRestore"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_backup"
                android:text="@string/settings_backup_and_restore" />

        </LinearLayout>

        <TextView
            style="@style/LavEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_group_about" />

        <LinearLayout
            style="@style/LavGroupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvAbout"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_about"
                android:text="@string/settings_about" />

            <View style="@style/LavRowDivider" />

            <TextView
                android:id="@+id/tvRate"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_rate"
                android:text="@string/settings_rate" />

            <View style="@style/LavRowDivider" />

            <TextView
                android:id="@+id/tvFeedback"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_feedback"
                android:text="@string/settings_feedback" />

            <View style="@style/LavRowDivider" />

            <TextView
                android:id="@+id/tvOtherApps"
                style="@style/LavSettingRow"
                android:drawableStart="@drawable/drawable_app_store"
                android:text="@string/settings_other_apps" />

        </LinearLayout>

        <!-- Kept and hidden, as before: SettingsActivity still binds these. -->
        <TextView
            android:id="@+id/tvGitHub"
            style="@style/LavSettingRow"
            android:drawableStart="@drawable/drawable_git_hub"
            android:text="@string/settings_git_hub"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPrivacyPolicy"
            style="@style/LavSettingRow"
            android:drawableStart="@drawable/drawable_privacy_policy"
            android:text="@string/settings_privacy_policy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLicenses"
            style="@style/LavSettingRow"
            android:drawableStart="@drawable/drawable_licenses"
            android:text="@string/settings_licenses"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
