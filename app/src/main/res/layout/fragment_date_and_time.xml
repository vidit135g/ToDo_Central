<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/somaBg"
    android:paddingTop="8dp"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clDateFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:background="@drawable/bg_lav_card"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvDateFormatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preferences_date_format_title"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/somaTextP"
            android:textSize="@dimen/text_body"
            app:layout_constraintBottom_toTopOf="@id/tvDateFormatSummary"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDateFormatSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/preferences_date_format_summary"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/somaTextM"
            android:textSize="@dimen/text_caption"
            android:lineSpacingMultiplier="1.25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDateFormatTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTimeFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:background="@drawable/bg_lav_card"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvTimeFormatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preferences_time_format_title"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/somaTextP"
            android:textSize="@dimen/text_body"
            app:layout_constraintBottom_toTopOf="@id/tvTimeFormatSummary"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTimeFormatSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/preferences_time_format_summary"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/somaTextM"
            android:textSize="@dimen/text_caption"
            android:lineSpacingMultiplier="1.25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTimeFormatTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>