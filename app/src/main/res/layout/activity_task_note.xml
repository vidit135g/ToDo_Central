<?xml version="1.0" encoding="utf-8"?>
<!-- Note editor: one card the text sits inside, so the writing area reads as
     a sheet rather than loose text on the page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/somaBg"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:id="@+id/svTaskDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbarSize="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:background="@drawable/bg_lav_group_card"
            app:hintAnimationEnabled="false"
            app:hintEnabled="false">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/tvTaskNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/hint_note"
                android:inputType="textAutoCorrect|textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minHeight="220dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/somaTextP"
                android:textColorHint="?attr/somaTextM"
                android:textSize="@dimen/text_body"
                android:lineSpacingMultiplier="1.4" />
        </com.google.android.material.textfield.TextInputLayout>
    </ScrollView>
</LinearLayout>
