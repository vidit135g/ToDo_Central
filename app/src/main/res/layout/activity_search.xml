<?xml version="1.0" encoding="utf-8"?>
<!--
  Search. The two 400dp stock Lottie illustrations are gone: they dominated
  the screen and belonged to a different visual language. What is left is the
  query, the results, and a short line saying which state you are in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/somaBg"
    tools:context=".ui.view.SearchActivity">

    <include layout="@layout/toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResultsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/llEmptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="88dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:background="@drawable/bg_lav_circle_light">

                <ImageView
                    android:id="@+id/ivEmptyIllustration"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lav_search"
                    app:tint="?attr/somaPrimary"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/ivNotFound"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lav_search_off"
                    app:tint="?attr/somaPrimary"
                    android:visibility="gone"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/search_view_empty_text"
                android:fontFamily="@font/poppins_extrabold"
                android:textColor="?attr/somaTextP"
                android:textSize="@dimen/text_section" />

            <TextView
                android:id="@+id/tvEmptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/search_empty_body"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/somaTextM"
                android:textSize="@dimen/text_caption"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
