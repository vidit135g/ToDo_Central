<?xml version="1.0" encoding="utf-8"?>
<!-- Track for a task with no subtasks: present, so cards stay aligned, but
     visibly inert rather than a zeroed progress bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1.5dp" android:color="?attr/somaBorderSub" android:dashWidth="4dp" android:dashGap="4dp" />
    <corners android:radius="4dp" />
</shape>
