<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Soma dosha-period themes, ported from Notes Central so the two apps
         read as one family. Each period also fills this app's own colour
         attrs (colorToolbar, colorBackground, ...) so the existing screens
         re-theme without being rewritten. -->

    <style name="AppTheme.SomaBase.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:windowBackground">?attr/somaBg</item>
        <item name="android:statusBarColor">?attr/somaBg</item>
        <item name="android:navigationBarColor">?attr/somaElev</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorControlNormal">?attr/somaTextM</item>
        <item name="alertDialogTheme">@style/LavDialog</item>
        <item name="materialAlertDialogTheme">@style/LavDialog</item>
    </style>

    <style name="AppTheme.SomaBase.Dark" parent="Theme.MaterialComponents.NoActionBar">
