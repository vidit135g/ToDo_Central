    <!-- Count chip in the "All tasks" filter row. Its ground is set in code
         so the selected one can flip without a second style. -->
    <style name="LavChip">
        <item name="android:background">@drawable/bg_lav_chip_off</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/somaTextS</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Framework and Material dialogs were inheriting a stock blue on a stock
         ground, which is what the rate prompt was showing over the home. -->
    <style name="LavDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">?attr/somaElev</item>
        <item name="colorAccent">?attr/somaPrimary</item>
        <item name="android:textColorPrimary">?attr/somaTextP</item>
        <item name="android:textColorSecondary">?attr/somaTextM</item>
        <item name="buttonBarPositiveButtonStyle">@style/LavDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/LavDialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/LavDialog.Button</item>
    </style>

    <style name="LavDialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/somaPrimary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Settings: an eyebrow over a card of rows. -->
    <style name="LavEyebrow">
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:textSize">@dimen/text_eyebrow</item>
        <item name="android:textColor">?attr/somaTextM</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="LavGroupCard">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_lav_group_card</item>
    </style>

    <style name="LavSettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableEnd">@drawable/drawable_arrow</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">?attr/somaTextP</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="LavRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">52dp</item>
        <item name="android:background">?attr/somaBorderSub</item>
    </style>

    <!-- Dialog actions: one loud, the rest quiet. -->
    <style name="LavDialogButton.Loud" parent="">
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_lav_cta</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:textColor">?attr/somaOnFill</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LavDialogButton.Quiet" parent="">
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_lav_cta_quiet</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">?attr/somaTextS</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Destructive confirm. dialog_default is only ever the delete prompt,
         so its primary action carries the same rose used for late work. -->
    <style name="LavDialogButton.Danger" parent="">
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_lav_cta_danger</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
