    <color name="soma_splash_bg">#7C4DE0</color>
    <color name="soma_splash_ink">#33220F</color>

    <!-- Late work reads rust against every Soma ground; distinct from the amber star. -->
    <color name="soma_overdue">#C42A5E</color>

    <!-- 18% of the late rose, for the "LATE" pill behind rose text. -->
    <color name="soma_overdue_tint">#2EC42A5E</color>

    <!-- Starred. Amber so it never reads as the lime progress accent or the
         rose used for late work. -->
    <color name="soma_star">#F0A93C</color>

    <!-- The lime accent is fixed rather than per-period: it has to carry dark
         text on both the light and the dark grounds, and a period-tinted
         version goes muddy on the dark ones. -->
    <color name="soma_accent_fill">#D8F0A8</color>
    <color name="soma_accent_ink">#2E4712</color>

    <!-- The late rose lifted for dark grounds; #C42A5E goes muddy on them. -->
    <color name="soma_overdue_on_dark">#FF7FA8</color>

    <!-- Widget palette. RemoteViews cannot read theme attrs, so these are
